[Unit]
Description=EdgeBox management WLAN DHCP only
After=edge-ap.service edgebox-ap-isolation.service
Requires=edgebox-ap-isolation.service
Wants=edge-ap.service
StartLimitIntervalSec=0

[Service]
Type=simple
Group=edge-dhcp
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/edgebox/ap-dhcp.conf --user=edge-dhcp --group=edge-dhcp
Restart=always
RestartSec=3s
RuntimeDirectory=edgebox-ap-dhcp
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/edgebox/ap /run/edgebox-ap-dhcp
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
